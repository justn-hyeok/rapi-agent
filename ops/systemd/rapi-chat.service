[Unit]
Description=Rapi Discord Gateway ChatOps service
After=network-online.target rapi-bot.service
Wants=network-online.target
Requires=rapi-bot.service

[Service]
Type=simple
User=justn
WorkingDirectory=/home/justn/rapi-agent
ExecStart=/usr/local/bin/npm run start:chat
Restart=on-failure
RestartSec=5
PrivateTmp=true

[Install]
WantedBy=multi-user.target
