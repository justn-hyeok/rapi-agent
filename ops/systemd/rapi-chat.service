[Unit]
Description=Rapi Discord Gateway ChatOps service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=10

[Service]
Type=simple
User=justn
WorkingDirectory=/home/justn/rapi-agent
ExecStart=/usr/local/bin/npm run start:chat
Restart=on-failure
RestartSec=30
PrivateTmp=true
SupplementaryGroups=rapi

[Install]
WantedBy=multi-user.target
