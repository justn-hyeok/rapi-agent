[Unit]
Description=Rapi collection and delivery worker
After=network-online.target rapi-bot.service
Wants=network-online.target

[Service]
Type=simple
User=justn
WorkingDirectory=/home/justn/rapi-agent
ExecStart=/usr/local/bin/npm run start:worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/justn/rapi-agent

[Install]
WantedBy=multi-user.target
