[Unit]
Description=Rapi Discord bot and webhook API
After=network-online.target rapi-public-agent.service
Wants=network-online.target

[Service]
Type=simple
User=justn
WorkingDirectory=/home/justn/rapi-agent
ExecStart=/usr/local/bin/npm run start:bot
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/justn/rapi-agent /var/lib/rapi /run/rapi-public-agent
SupplementaryGroups=rapi

[Install]
WantedBy=multi-user.target
