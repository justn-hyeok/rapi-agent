[Unit]
Description=Weekly Rapi backup restore verification
After=docker.service rapi-backup.service
Requires=docker.service

[Service]
Type=oneshot
User=justn
Group=docker
WorkingDirectory=/home/justn/rapi-agent
EnvironmentFile=/home/justn/rapi-agent/.env
Environment=RESTORE_LATEST_BACKUP=true
Environment=RESTORE_SMOKE_PROJECT=rapi-restore-weekly
Environment=RESTORE_SMOKE_DATABASE=rapi_restore_smoke_weekly
ExecStart=/home/justn/rapi-agent/scripts/restore-smoke.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
