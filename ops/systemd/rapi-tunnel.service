[Unit]
Description=Rapi public Discord interaction tunnel
After=network-online.target rapi-public-gateway.service
Wants=network-online.target
Requires=rapi-public-gateway.service

[Service]
Type=simple
User=justn
WorkingDirectory=/home/justn/rapi-agent
ExecStart=/usr/local/bin/cloudflared --no-autoupdate --config /var/lib/rapi/cloudflared/config.yml tunnel run
Restart=always
RestartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/lib/rapi/cloudflared

[Install]
WantedBy=multi-user.target
