RAPI_ENV=
RAPI_LOG_LEVEL=
PORT=
DATABASE_URL=
MIGRATION_DATABASE_URL=
RAPI_RUNTIME_DATABASE_ROLE=
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=5000
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_ALLOWED_USER_IDS=
DISCORD_SUPERADMIN_USER_IDS=
DISCORD_ADMIN_USER_IDS=
DISCORD_USER_IDS=
DISCORD_ADMIN_ROLE_IDS=
DISCORD_USER_ROLE_IDS=
DISCORD_GUILD_MEMBERS_ARE_USERS=false
DISCORD_ALLOWED_GUILD_IDS=
# Optional: operator guild; defaults to COMMUNITY_GUILD_ID, then the first allowed guild
DISCORD_HOME_GUILD_ID=
DISCORD_ALLOWED_CHANNEL_IDS=
REGISTER_DISCORD_COMMANDS=
GITHUB_READ_TOKEN=
POLL_INTERVAL_SECONDS=
DELIVERY_INTERVAL_SECONDS=
COMMUNITY_GUILD_ID=
TECHNICAL_RSS_WEBHOOK_NAME=technical-rss-output
MODEL_API_KEY=
# Optional: enables POST /webhooks/:sourceId
WEBHOOK_SECRET=
# 32 random bytes in base64; encrypts managed webhook secrets
WEBHOOK_ENCRYPTION_KEY=
# Fixed HTTPS origin; Quick Tunnel URLs are rejected for managed inbound webhooks
RAPI_PUBLIC_BASE_URL=
PUBLIC_TUNNEL_VERIFIED_FILE=/var/lib/rapi/tunnel-verified.json
OPERATIONS_CHANNEL_ID=
OPERATIONS_DISCORD_WEBHOOK_CIPHERTEXT=
MONITOR_STATE_FILE=/var/lib/rapi/monitor-state.json
BACKUP_STATUS_FILE=backups/backup-status.json
DATABASE_SIZE_LIMIT_BYTES=500000000
MONITOR_INTERVAL_SECONDS=30
MONITOR_PORT=3300
CHAT_HEALTH_PORT=3100
# Optional: ChatOps coding harness. codex (default) | senpi (owner execution runs only).
# CHATOPS_HARNESS=codex
# SENPI_BIN=/usr/local/bin/senpi
# SENPI_HOME=/var/lib/rapi/senpi
PUBLIC_AGENT_SOCKET=/run/rapi-public-agent/agent.sock
PUBLIC_AGENT_ENABLED=false
PUBLIC_AGENT_HEALTH_PORT=3500
PUBLIC_AGENT_READY_URL=http://127.0.0.1:3500/ready
PUBLIC_GATEWAY_READY_URL=http://127.0.0.1:3601/ready
CLOUDFLARE_TUNNEL_READY_URL=http://127.0.0.1:3700/ready
RAPI_ADMIN_CHANNEL_ID=
DISCORD_LAYOUT_FILE=/home/justn/rapi-agent/config/discord-channels.yaml
WORKER_HEALTH_PORT=3400
BOT_READY_URL=http://127.0.0.1:3000/ready
CHAT_READY_URL=http://127.0.0.1:3100/ready
WORKER_READY_URL=http://127.0.0.1:3400/ready
CLOUDFLARE_TUNNEL_TOKEN=
RAPI_BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=30
# Generate 32 random bytes as hexadecimal; never put the real value in Git.
PRIVACY_HMAC_KEY=
PRIVACY_STATUS_FILE=
EMAIL_TRANSPORT=
EMAIL_FROM=
EMAIL_TEST_RECIPIENTS=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional: phase-0 learner DM experiment (off by default). When true it also needs
# WEBHOOK_ENCRYPTION_KEY, RAPI_PUBLIC_BASE_URL and DISCORD_SUPERADMIN_USER_IDS.
# Click links are signed with a key derived from WEBHOOK_ENCRYPTION_KEY.
# LEARNER_EXPERIMENT_ENABLED=false
# Optional: web with Discord login (/me, /archive, /u/<token>); off by default. When true it also
# needs RAPI_PUBLIC_BASE_URL and WEBHOOK_ENCRYPTION_KEY (session/CSRF/unsubscribe keys derive from
# it). Add ${RAPI_PUBLIC_BASE_URL}/auth/discord/callback as a redirect in the Discord developer portal.
# WEB_ENABLED=false
# DISCORD_OAUTH_CLIENT_ID=
# DISCORD_OAUTH_CLIENT_SECRET=
# Optional: enables the e-mail option on /me (lane M3 provides the sender; shown as "준비 중" otherwise).
# EMAIL_ENABLED=false
# Optional: detect new releases of pinned harnesses (ops/harness-versions.json) and DM
# every SUPERADMIN a recommendation with buttons (off by default; needs
# DISCORD_SUPERADMIN_USER_IDS). Applying opens a PR through the VM's logged-in gh CLI.
# GITHUB_READ_TOKEN, when set, also authenticates the release lookups.
# HARNESS_UPDATES_ENABLED=false
# HARNESS_UPDATES_REPO=justn-hyeok/rapi-agent
# HARNESS_UPDATES_BASE_BRANCH=main
# Optional: direct model calls through one client (off unless both BASE_URL and KEY are set).
# Point at LiteLLM (http://127.0.0.1:4000/v1, see docs/operations.md "LiteLLM 켜기"), OpenAI
# (https://api.openai.com/v1) or another OpenAI-compatible endpoint. Plain http is loopback only.
# MODEL_API_BASE_URL=
# MODEL_API_KEY=
# MODEL_DEFAULT=
# Per-feature overrides: SUMMARY, REWRITE, ARCHIVE_QA, PUBLIC_QA, CHATBOT, BLOG_DRAFT, REPO_REPORT
# MODEL_FOR_PUBLIC_QA=
# Monthly cap in USD (calendar month, Asia/Seoul). Unset = metering only. DMs every SUPERADMIN at
# 80% and 100%; at 100% public features stop and owner features keep running.
# MODEL_MONTHLY_BUDGET_USD=
# Fallback prices when the gateway reports no cost (default ops/model-prices.json).
# MODEL_PRICES_FILE=
# Summaries via the API client instead of the codex CLI (default codex).
# SUMMARIZER_BACKEND=codex
# Optional: GitHub App on the owner's own repos (off by default; see docs/operations.md
# "GitHub App 만들기"). When true it needs all of the following plus
# DISCORD_SUPERADMIN_USER_IDS. Allowed owners are the accounts the App may be installed
# on; owner logins are the only people whose `@rapi` comments run work.
# GITHUB_APP_ENABLED=false
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=/home/justn/secrets/rapi-github-app.pem
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_ALLOWED_OWNERS=justn-hyeok
# GITHUB_APP_OWNER_LOGINS=justn-hyeok
# Weekly repo report (Monday 09:00 Asia/Seoul): dm (default) or issue (also comments on a
# "rapi-weekly-report" issue in each repo).
# GITHUB_REPORT_TARGET=dm
