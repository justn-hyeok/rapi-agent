RAPI_ENV=
RAPI_LOG_LEVEL=
PORT=
DATABASE_URL=
MIGRATION_DATABASE_URL=
RAPI_RUNTIME_DATABASE_ROLE=
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=5000
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_ALLOWED_USER_IDS=
DISCORD_SUPERADMIN_USER_IDS=
DISCORD_ADMIN_USER_IDS=
DISCORD_USER_IDS=
DISCORD_ADMIN_ROLE_IDS=
DISCORD_USER_ROLE_IDS=
DISCORD_GUILD_MEMBERS_ARE_USERS=false
DISCORD_ALLOWED_GUILD_IDS=
# Optional: operator guild; defaults to COMMUNITY_GUILD_ID, then the first allowed guild
DISCORD_HOME_GUILD_ID=
DISCORD_ALLOWED_CHANNEL_IDS=
REGISTER_DISCORD_COMMANDS=
GITHUB_READ_TOKEN=
POLL_INTERVAL_SECONDS=
DELIVERY_INTERVAL_SECONDS=
COMMUNITY_GUILD_ID=
TECHNICAL_RSS_WEBHOOK_NAME=technical-rss-output
# Optional: enables POST /webhooks/:sourceId
WEBHOOK_SECRET=
# 32 random bytes in base64; encrypts managed webhook secrets
WEBHOOK_ENCRYPTION_KEY=
# Fixed HTTPS origin; Quick Tunnel URLs are rejected for managed inbound webhooks
RAPI_PUBLIC_BASE_URL=
PUBLIC_TUNNEL_VERIFIED_FILE=/var/lib/rapi/tunnel-verified.json
OPERATIONS_CHANNEL_ID=
OPERATIONS_DISCORD_WEBHOOK_CIPHERTEXT=
MONITOR_STATE_FILE=/var/lib/rapi/monitor-state.json
BACKUP_STATUS_FILE=backups/backup-status.json
DATABASE_SIZE_LIMIT_BYTES=500000000
MONITOR_INTERVAL_SECONDS=30
MONITOR_PORT=3300
CHAT_HEALTH_PORT=3100
# Optional: ChatOps coding harness. codex (default) | senpi (owner execution runs only).
# CHATOPS_HARNESS=codex
# SENPI_BIN=/usr/local/bin/senpi
# SENPI_HOME=/var/lib/rapi/senpi
PUBLIC_AGENT_SOCKET=/run/rapi-public-agent/agent.sock
PUBLIC_AGENT_ENABLED=false
# Public answer backend. "codex" (default) is the subscription-login CLI with web search;
# "api" is a plain model call (API key or gateway) with no tools and no search. The
# executor service reads PUBLIC_AGENT_BACKEND, PUBLIC_AGENT_API_KEY, PUBLIC_AGENT_API_MODEL
# and PUBLIC_AGENT_API_BASE_URL from /etc/rapi-public-agent.env, not from this file.
# Both this file and /etc/rapi-public-agent.env must say PUBLIC_AGENT_BACKEND=api before CHATBOT_ENABLED.
# PUBLIC_AGENT_BACKEND=codex
# Optional: archive Q&A chatbot in the public channel (off by default). Needs
# PUBLIC_AGENT_ENABLED and PUBLIC_AGENT_BACKEND=api.
# CHATBOT_ENABLED=false
# Optional: L2 explanations (pasted errors, public GitHub repo structure). Needs CHATBOT_ENABLED.
# CHATBOT_L2_ENABLED=false
# Optional: widen archive search with a cheap model (query expansion + rerank). Needs
# CHATBOT_ENABLED and MODEL_API_*; model failures fall back to keyword search.
# CHATBOT_RERANK_ENABLED=false
# Optional: also search through the knowledge graph (needs CHATBOT_ENABLED and an indexed graph).
# CHATBOT_GRAPH_ENABLED=false
# Optional: the archive also holds title, 400 character lead and link of the newest 2000
# public collected items (last 90 days) of public sources. Needs CHATBOT_ENABLED.
# ARCHIVE_SOURCES_ENABLED=false
# Optional: the worker extracts entities/relations from archive posts with a cheap model
# (MODEL_FOR_GRAPH_EXTRACT), GRAPH_INDEX_BATCH posts per 10 minutes. Needs MODEL_API_*;
# count the cost first with `node scripts/graph-admin.mjs estimate`.
# GRAPH_INDEX_ENABLED=false
# GRAPH_INDEX_BATCH=10
PUBLIC_AGENT_HEALTH_PORT=3500
PUBLIC_AGENT_READY_URL=http://127.0.0.1:3500/ready
PUBLIC_GATEWAY_READY_URL=http://127.0.0.1:3601/ready
CLOUDFLARE_TUNNEL_READY_URL=http://127.0.0.1:3700/ready
RAPI_ADMIN_CHANNEL_ID=
DISCORD_LAYOUT_FILE=/home/justn/rapi-agent/config/discord-channels.yaml
WORKER_HEALTH_PORT=3400
BOT_READY_URL=http://127.0.0.1:3000/ready
CHAT_READY_URL=http://127.0.0.1:3100/ready
WORKER_READY_URL=http://127.0.0.1:3400/ready
CLOUDFLARE_TUNNEL_TOKEN=
RAPI_BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=30
# Generate 32 random bytes as hexadecimal; never put the real value in Git.
PRIVACY_HMAC_KEY=
PRIVACY_STATUS_FILE=
EMAIL_TRANSPORT=
# Shared by the SMTP path and the email channel (EMAIL_ENABLED); bare address only, e.g. news@example.com.
EMAIL_FROM=
EMAIL_TEST_RECIPIENTS=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional: phase-0 learner DM experiment (off by default). When true it also needs
# WEBHOOK_ENCRYPTION_KEY, RAPI_PUBLIC_BASE_URL and DISCORD_SUPERADMIN_USER_IDS.
# Click links are signed with a key derived from WEBHOOK_ENCRYPTION_KEY.
# LEARNER_EXPERIMENT_ENABLED=false
# Optional: web with Discord login (/me, /admin/*, /archive, /u/<token>); off by default. When on, the 9 moved
# slash commands (see README) answer with a link to their /admin page. When true it also
# needs RAPI_PUBLIC_BASE_URL and WEBHOOK_ENCRYPTION_KEY (session/CSRF/unsubscribe keys derive from
# it). Add ${RAPI_PUBLIC_BASE_URL}/auth/discord/callback as a redirect in the Discord developer portal.
# WEB_ENABLED=false
# DISCORD_OAUTH_CLIENT_ID=
# DISCORD_OAUTH_CLIENT_SECRET=
# Optional: email channel for learner issues (off by default). Needs
# LEARNER_EXPERIMENT_ENABLED plus the settings below and the /e/ paths on the
# public gateway. EMAIL_WEBHOOK_SECRET: Resend's whsec_ signing secret, or the
# user:password of the Postmark webhook's Basic auth. See docs/operations.md "메일 켜기".
# EMAIL_ENABLED=false
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=
# EMAIL_REPLY_TO=
# Postmark only: message stream id (default "outbound"); recurring issues may need a Broadcast stream.
# EMAIL_POSTMARK_STREAM=
# EMAIL_WEBHOOK_SECRET=
# Optional: detect new releases of pinned harnesses (ops/harness-versions.json) and DM
# every SUPERADMIN a recommendation with buttons (off by default; needs
# DISCORD_SUPERADMIN_USER_IDS). Applying opens a PR through the VM's logged-in gh CLI.
# GITHUB_READ_TOKEN, when set, also authenticates the release lookups.
# HARNESS_UPDATES_ENABLED=false
# HARNESS_UPDATES_REPO=justn-hyeok/rapi-agent
# HARNESS_UPDATES_BASE_BRANCH=main
# Optional: direct model calls through one client (off unless both BASE_URL and KEY are set).
# Point at LiteLLM (http://127.0.0.1:4000/v1, see docs/operations.md "LiteLLM 켜기"), OpenAI
# (https://api.openai.com/v1) or another OpenAI-compatible endpoint. Plain http is loopback only.
# MODEL_API_BASE_URL=
# MODEL_API_KEY=
# MODEL_DEFAULT=
# Per-feature overrides: SUMMARY, REWRITE, ARCHIVE_QA, PUBLIC_QA, CHATBOT, BLOG_DRAFT, REPO_REPORT
# MODEL_FOR_PUBLIC_QA=
# Monthly cap in USD (calendar month, Asia/Seoul). Unset = metering only. DMs every SUPERADMIN at
# 80% and 100%; at 100% public features stop and owner features keep running.
# MODEL_MONTHLY_BUDGET_USD=
# Fallback prices when the gateway reports no cost (default ops/model-prices.json).
# MODEL_PRICES_FILE=
# Summaries via the API client instead of the codex CLI (default codex).
# SUMMARIZER_BACKEND=codex
# Optional: GitHub App on the owner's own repos (off by default; see docs/operations.md
# "GitHub App 만들기"). When true it needs all of the following plus
# DISCORD_SUPERADMIN_USER_IDS. Allowed owners are the accounts the App may be installed
# on; owner logins are the only people whose `@rapi` comments run work.
# GITHUB_APP_ENABLED=false
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=/home/justn/secrets/rapi-github-app.pem
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_ALLOWED_OWNERS=justn-hyeok
# GITHUB_APP_OWNER_LOGINS=justn-hyeok
# Weekly repo report (Monday 09:00 Asia/Seoul): dm (default) or issue (also comments on a
# "rapi-weekly-report" issue in each repo).
# GITHUB_REPORT_TARGET=dm
# Optional: blog archive (both off by default; both need DISCORD_SUPERADMIN_USER_IDS).
# BLOG_PUBLISH_ENABLED: after the owner's learner-issue [발송], also queue a blog post.
# BLOG_DRAFTS_ENABLED: owner "블로그 초안: 주제" requests and one weekly topic proposal.
# Publishing opens a PR with the VM's logged-in gh CLI; merging it makes the post public.
# RAPI_BLOG_WITHDRAWALS_FILE (absolute path, same file the gateway reads) lets [내리기]
# hide a post at once; without it a withdrawn post stays up until the removal PR merges.
# BLOG_PUBLISH_ENABLED=false
# BLOG_DRAFTS_ENABLED=false
# Browser research stays off until dedicated-account login is verified.
# Owner-only private ChatOps: 라피야! 브라우저 조사: threads (or x, reddit)
# BROWSER_RESEARCH_ENABLED=false
# BROWSER_RESEARCH_BIN=/home/justn/browser-agent/node_modules/.bin/agent-browser
# BROWSER_RESEARCH_AUTH_DIR=/home/justn/secrets/browser-research
# BLOG_REPO=justn-hyeok/rapi-agent
# BLOG_BASE_BRANCH=main
# Optional: paid period passes via Toss Payments (OFF by default; see docs/operations.md
# "결제 (꺼짐)"). Nothing is sold and no price is shown while BILLING_ENABLED is false; every
# /billing route answers 404. BILLING_ENABLED needs WEB_ENABLED, RAPI_PUBLIC_BASE_URL and both
# Toss keys. Unless BILLING_LIVE=true the keys must start with test_ (live_ keys are refused).
# Setting BILLING_LIVE to true is the switch for AFTER 통신판매업 신고 and the Toss merchant contract.
# Toss publishes documentation test keys that work without an account; they are listed in
# docs/operations.md "결제 (꺼짐)" (kept out of this file so the secret scan stays clean).
# BILLING_ENABLED=false
# BILLING_LIVE=false
# TOSS_CLIENT_KEY=
# TOSS_SECRET_KEY=
# Plan list (default ops/billing-plans.json).
# BILLING_PLANS_FILE=
