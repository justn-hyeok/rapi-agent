{
  "name": "rapi-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "workers/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b",
    "bootstrap": "./scripts/bootstrap.sh",
    "clean": "tsc -b --clean",
    "dev:infra": "docker compose up -d postgres",
    "db:verify": "./scripts/verify-db.sh",
    "db:migrate": "./scripts/migrate.sh",
    "db:grant-runtime": "node scripts/grant-runtime.mjs",
    "supabase:configure": "./scripts/configure-supabase.sh",
    "restart:smoke": "./scripts/restart-smoke.sh",
    "backup": "./scripts/backup.sh",
    "encrypt:webhook": "node scripts/encrypt-secret.mjs",
    "discord:rotate-token": "./scripts/rotate-discord-token.sh",
    "discord:register-commands": "node --env-file=.env --import tsx scripts/register-discord-commands.ts",
    "tunnel:configure": "./scripts/configure-cloudflare-tunnel.sh",
    "community:configure": "./scripts/configure-community.sh",
    "discord-layout:import": "node --import tsx scripts/import-discord-layout.ts",
    "public-agent:install": "./scripts/install-public-agent.sh",
    "restore:smoke": "./scripts/restore-smoke.sh",
    "start:bot": "node --env-file=.env --import tsx apps/bot/src/run.ts",
    "start:chat": "node --env-file=.env --import tsx apps/chat/src/run.ts",
    "start:omp": "node --env-file=.env --import tsx apps/omp/src/run.ts",
    "start:monitor": "node --env-file=.env --import tsx apps/monitor/src/run.ts",
    "start:public-agent": "node --import tsx apps/public-agent/src/run.ts",
    "start:worker": "node --env-file=.env --import tsx workers/runtime/src/run.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "./scripts/test-e2e.sh",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.1",
    "pg": "8.16.3",
    "yaml": "^2.9.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.13.4",
    "@types/pg": "8.15.5",
    "eslint": "10.10.0",
    "prettier": "3.5.0",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.70.0"
  }
}
